# Optional Supabase backend for Google sign-in and cross-device sync.
#
# TidyLine is local-first: it runs fully offline (guest mode, tasks in this
# browser's localStorage) with neither of these set. Set both only if you
# want Google sign-in via Supabase Auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
