# Optional Supabase backend for Google sign-in and cross-device sync.
#
# Without these values, guest tasks stay in this browser's localStorage.
# Signed-in sync needs both values and the SQL schema in supabase_migration.sql
# plus supabase_migrations/20260918_atomic_task_replace.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
