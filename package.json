{
  "name": "tidyline-web",
  "private": true,
  "version": "0.1.0",
  "description": "Deadline-driven reminder board built with React + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-service-worker.js && node --check dist/sw.js",
    "lint": "eslint .",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --logLevel warn && node .smoke/smoke.js",
    "check": "npm run lint && npm run task-data-tests && npm run build && npm run service-worker-tests && npm run smoke && npm run phase1-smoke && npm run phase2-smoke && npm run phase3-smoke && npm run parser-tests",
    "task-data-tests": "node scripts/task-data-tests.js",
    "service-worker-tests": "node scripts/service-worker-tests.js",
    "phase1-smoke": "vite build --ssr scripts/phase1-smoke.js --outDir .phase1-smoke --logLevel warn && node .phase1-smoke/phase1-smoke.js",
    "phase2-smoke": "vite build --ssr scripts/phase2-smoke.js --outDir .phase2-smoke --logLevel warn && node .phase2-smoke/phase2-smoke.js",
    "phase3-smoke": "vite build --ssr scripts/phase3-smoke.js --outDir .phase3-smoke --logLevel warn && node .phase3-smoke/phase3-smoke.js",
    "parser-tests": "vite build --ssr scripts/parser-tests.js --outDir .parser-tests --logLevel warn && node .parser-tests/parser-tests.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "chrono-node": "^2.10.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "wouter": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.4"
  }
}
